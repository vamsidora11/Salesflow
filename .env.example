# Copy to .env and replace every CHANGE_ME with a random value, e.g.
#   python -c "import secrets; print(secrets.token_hex(24))"
# .env is git-ignored. Never commit real values.

APP_ENV=local
LOG_LEVEL=INFO

# Host port for the nginx entrypoint (http://localhost:8080)
HOST_HTTP_PORT=8080

# TimescaleDB / PostgreSQL
POSTGRES_USER=salesflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=salesflow

# Redis
REDIS_PASSWORD=CHANGE_ME

# MinIO (S3-compatible export storage for exports)
MINIO_ROOT_USER=salesflow
MINIO_ROOT_PASSWORD=CHANGE_ME

# JWT signing key for dashboard users (the API refuses to start in non-local envs with the default)
JWT_SECRET=CHANGE_ME

# Grafana admin password (monitoring profile)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# --- Optional ---
# Host the browser uses to reach MinIO for presigned export downloads (set to your public S3/MinIO URL)
# PUBLIC_S3_URL=http://localhost:9000
# Raw event retention in days (migration 0002 reads this when it first runs)
# RAW_RETENTION_DAYS=90
# Make every Celery Beat job fire every N seconds (testing the scheduler only)
# BEAT_TEST_INTERVAL_SECONDS=10

# Only needed when running the backend on the host (outside Docker).
# Inside Compose these are derived from the values above.
# DATABASE_URL=postgresql://salesflow:CHANGE_ME@localhost:5432/salesflow
# REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
# KAFKA_BOOTSTRAP_SERVERS=localhost:29092
